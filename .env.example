# testdata-ai Configuration
# Copy this file to .env and add your actual keys

# === AI PROVIDER SETTINGS ===

# Default provider to use (openai, anthropic, ollama, gemini, mistral, or cohere)
AI_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-proj-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=4096

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_TEMPERATURE=0.7
ANTHROPIC_MAX_TOKENS=4096

# Ollama (local, no API key required)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_TEMPERATURE=0.7
OLLAMA_MAX_TOKENS=4096

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=4096

# Mistral
MISTRAL_API_KEY=your-mistral-api-key-here
MISTRAL_MODEL=mistral-small-latest
MISTRAL_TEMPERATURE=0.7
MISTRAL_MAX_TOKENS=4096

# Cohere
COHERE_API_KEY=your-cohere-api-key-here
COHERE_MODEL=command-r
COHERE_TEMPERATURE=0.7
COHERE_MAX_TOKENS=4096
